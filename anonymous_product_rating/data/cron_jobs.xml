<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Daily cleanup of old unpublished ratings -->
        <record id="cron_cleanup_old_ratings" model="ir.cron">
            <field name="name">Anonymous Rating: Cleanup Old Ratings</field>
            <field name="model_id" ref="anonymous_product_rating.model_anonymous_rating"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_ratings(days=365)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Hourly auto-moderation of spam ratings -->
        <record id="cron_auto_moderate_spam" model="ir.cron">
            <field name="name">Anonymous Rating: Auto-moderate Spam</field>
            <field name="model_id" ref="anonymous_product_rating.model_anonymous_rating"/>
            <field name="state">code</field>
            <field name="code">model.auto_moderate_by_spam_score(threshold=0.8)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Weekly cache cleanup -->
        <record id="cron_clear_rating_caches" model="ir.cron">
            <field name="name">Anonymous Rating: Clear Caches</field>
            <field name="model_id" ref="anonymous_product_rating.model_anonymous_rating"/>
            <field name="state">code</field>
            <field name="code">model.cron_clear_caches()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Daily sync of anonymous ratings to core system -->
        <record id="cron_sync_ratings_to_core" model="ir.cron">
            <field name="name">Anonymous Rating: Sync to Core System</field>
            <field name="model_id" ref="anonymous_product_rating.model_anonymous_rating"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_ratings_to_core()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Hourly serialization recovery -->
        <record id="cron_serialization_recovery" model="ir.cron">
            <field name="name">Anonymous Rating: Serialization Recovery</field>
            <field name="model_id" ref="anonymous_product_rating.model_anonymous_rating"/>
            <field name="state">code</field>
            <field name="code">model.cron_serialization_recovery()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>