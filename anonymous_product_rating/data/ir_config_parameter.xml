<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Configuration Parameters -->
        <record id="config_auto_publish" model="ir.config_parameter">
            <field name="key">anonymous_product_rating.auto_publish</field>
            <field name="value">False</field>
        </record>

        <record id="config_rate_limit_hours" model="ir.config_parameter">
            <field name="key">anonymous_product_rating.rate_limit_hours</field>
            <field name="value">24</field>
        </record>

        <record id="config_max_ratings_per_period" model="ir.config_parameter">
            <field name="key">anonymous_product_rating.max_ratings_per_period</field>
            <field name="value">3</field>
        </record>

        <record id="config_recaptcha_min_score" model="ir.config_parameter">
            <field name="key">anonymous_product_rating.recaptcha_min_score</field>
            <field name="value">0.7</field>
        </record>

        <record id="config_enable_moderation" model="ir.config_parameter">
            <field name="key">anonymous_product_rating.enable_moderation</field>
            <field name="value">True</field>
        </record>

    </data>
</odoo>