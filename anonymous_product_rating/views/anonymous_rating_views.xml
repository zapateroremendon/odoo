<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Anonymous Rating Tree View -->
        <record id="anonymous_rating_view_tree" model="ir.ui.view">
            <field name="name">anonymous.rating.tree</field>
            <field name="model">anonymous.rating</field>
            <field name="arch" type="xml">
                <tree string="Anonymous Ratings" create="false" edit="false">
                    <field name="create_date"/>
                    <field name="author_name"/>
                    <field name="product_tmpl_id"/>
                    <field name="rating"/>
                    <field name="feedback"/>
                    <field name="has_images" widget="boolean_toggle"/>
                    <field name="image_count"/>
                    <field name="is_published" widget="boolean_toggle"/>
                    <field name="is_moderated"/>
                    <field name="ip_address" groups="base.group_system"/>
                </tree>
            </field>
        </record>

        <!-- Anonymous Rating Form View -->
        <record id="anonymous_rating_view_form" model="ir.ui.view">
            <field name="name">anonymous.rating.form</field>
            <field name="model">anonymous.rating</field>
            <field name="arch" type="xml">
                <form string="Anonymous Rating" create="false">
                    <header>
                        <button name="action_publish" string="Publish" type="object" 
                                class="btn-primary" invisible="is_published"/>
                        <button name="action_unpublish" string="Unpublish" type="object" 
                                class="btn-secondary" invisible="not is_published"/>
                        <field name="is_published" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="product_tmpl_id" readonly="1"/>
                                <field name="author_name" readonly="1"/>
                                <field name="author_email" readonly="1"/>
                                <field name="rating" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="is_moderated" readonly="1"/>
                                <field name="moderated_by" readonly="1" invisible="not is_moderated"/>
                                <field name="moderation_date" readonly="1" invisible="not is_moderated"/>
                                <field name="ip_address" readonly="1" groups="base.group_system"/>
                            </group>
                        </group>
                        <group string="Feedback">
                            <field name="feedback" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Review Images" invisible="not has_images">
                            <group>
                                <field name="image_1" widget="image" options="{'size': [200, 200]}" invisible="not image_1"/>
                                <field name="image_2" widget="image" options="{'size': [200, 200]}" invisible="not image_2"/>
                                <field name="image_3" widget="image" options="{'size': [200, 200]}" invisible="not image_3"/>
                            </group>
                            <group>
                                <field name="has_images" readonly="1"/>
                                <field name="image_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Moderation" invisible="not is_moderated">
                            <field name="moderation_reason" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Technical Info" groups="base.group_system">
                            <field name="user_agent" readonly="1"/>
                            <field name="recaptcha_token" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Anonymous Rating Search View -->
        <record id="anonymous_rating_view_search" model="ir.ui.view">
            <field name="name">anonymous.rating.search</field>
            <field name="model">anonymous.rating</field>
            <field name="arch" type="xml">
                <search string="Anonymous Ratings">
                    <field name="author_name"/>
                    <field name="product_tmpl_id"/>
                    <field name="feedback"/>
                    <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
                    <filter name="unpublished" string="Unpublished" domain="[('is_published', '=', False)]"/>
                    <filter name="moderated" string="Moderated" domain="[('is_moderated', '=', True)]"/>
                    <filter name="unmoderated" string="Unmoderated" domain="[('is_moderated', '=', False)]"/>
                    <filter name="with_images" string="With Images" domain="[('has_images', '=', True)]"/>
                    <filter name="without_images" string="Without Images" domain="[('has_images', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_product" string="Product" domain="[]" context="{'group_by': 'product_tmpl_id'}"/>
                        <filter name="group_published" string="Published" domain="[]" context="{'group_by': 'is_published'}"/>
                        <filter name="group_date" string="Date" domain="[]" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Anonymous Rating Action -->
        <record id="anonymous_rating_action" model="ir.actions.act_window">
            <field name="name">Anonymous Ratings</field>
            <field name="res_model">anonymous.rating</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="anonymous_rating_view_tree"/>
            <field name="search_view_id" ref="anonymous_rating_view_search"/>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No anonymous ratings yet!
                </p>
                <p>
                    Anonymous ratings will appear here when customers rate products without logging in.
                </p>
            </field>
        </record>

        <!-- Create the missing standard Ratings menu -->
        <record id="rating_rating_action_standard" model="ir.actions.act_window">
            <field name="name">Ratings</field>
            <field name="res_model">rating.rating</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No ratings yet!
                </p>
                <p>
                    Ratings from registered users will appear here.
                </p>
            </field>
        </record>

        <!-- Create Ratings section under Settings > Technical -->
        <menuitem id="menu_ratings_section" 
                  name="Ratings" 
                  parent="base.menu_custom" 
                  sequence="325"
                  groups="base.group_system"/>
        
        <!-- Standard Ratings Menu -->
        <menuitem id="menu_standard_ratings" 
                  name="Ratings" 
                  parent="menu_ratings_section" 
                  action="rating_rating_action_standard" 
                  sequence="10"
                  groups="base.group_system"/>
        
        <!-- Anonymous Ratings Menu -->
        <menuitem id="menu_anonymous_rating" 
                  name="Anonymous Ratings" 
                  parent="menu_ratings_section" 
                  action="anonymous_rating_action" 
                  sequence="20"
                  groups="base.group_system"/>

        <!-- Keep systems completely separate - no integration with rating.rating views -->

    </data>
</odoo>