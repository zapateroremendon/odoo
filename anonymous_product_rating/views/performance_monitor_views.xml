<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Performance Monitor Form View -->
        <record id="view_anonymous_rating_performance_monitor_form" model="ir.ui.view">
            <field name="name">anonymous.rating.performance.monitor.form</field>
            <field name="model">anonymous.rating.performance.monitor</field>
            <field name="arch" type="xml">
                <form string="Anonymous Rating Performance Monitor">
                    <sheet>
                        <div class="oe_title">
                            <h1>Performance Monitor</h1>
                        </div>
                        
                        <group>
                            <group string="Current Statistics">
                                <field name="total_ratings"/>
                                <field name="published_ratings"/>
                                <field name="pending_moderation"/>
                                <field name="spam_ratings"/>
                            </group>
                            <group string="Maintenance Options">
                                <field name="cleanup_days"/>
                                <field name="spam_threshold"/>
                            </group>
                        </group>
                        
                        <footer>
                            <button name="action_cleanup_old_ratings" type="object" 
                                    string="Cleanup Old Ratings" class="oe_highlight"/>
                            <button name="action_auto_moderate_spam" type="object" 
                                    string="Auto-moderate Spam"/>
                            <button name="action_clear_caches" type="object" 
                                    string="Clear Caches"/>
                            <button string="Cancel" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Performance Report Form View -->
        <record id="view_anonymous_rating_performance_report_form" model="ir.ui.view">
            <field name="name">anonymous.rating.performance.report.form</field>
            <field name="model">anonymous.rating.performance.report</field>
            <field name="arch" type="xml">
                <form string="Performance Report" create="false" edit="false">
                    <sheet>
                        <div class="oe_title">
                            <h1>Performance Report</h1>
                            <h2><field name="report_date"/></h2>
                        </div>
                        
                        <group>
                            <group string="Rating Statistics">
                                <field name="total_ratings"/>
                                <field name="published_ratings"/>
                                <field name="recent_ratings"/>
                                <field name="publication_rate"/>
                            </group>
                            <group string="Quality Metrics">
                                <field name="high_spam_ratings"/>
                                <field name="avg_spam_score"/>
                                <field name="spam_rate"/>
                            </group>
                        </group>
                        
                        <group string="Top Products">
                            <field name="top_products_data" widget="text"/>
                        </group>
                        
                        <footer>
                            <button string="Close" class="oe_highlight" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Enhanced Anonymous Rating Tree View with Performance Indicators -->
        <record id="view_anonymous_rating_tree_enhanced" model="ir.ui.view">
            <field name="name">anonymous.rating.tree.enhanced</field>
            <field name="model">anonymous.rating</field>
            <field name="arch" type="xml">
                <tree string="Anonymous Ratings" default_order="create_date desc">
                    <field name="create_date"/>
                    <field name="product_tmpl_id"/>
                    <field name="author_name"/>
                    <field name="rating"/>
                    <field name="is_published"/>
                    <field name="is_moderated"/>
                    <field name="spam_score"/>
                </tree>
            </field>
        </record>

        <!-- Enhanced Anonymous Rating Form View -->
        <record id="view_anonymous_rating_form_enhanced" model="ir.ui.view">
            <field name="name">anonymous.rating.form.enhanced</field>
            <field name="model">anonymous.rating</field>
            <field name="arch" type="xml">
                <form string="Anonymous Rating">
                    <header>
                        <button name="action_publish" type="object" string="Publish" 
                                class="oe_highlight" invisible="is_published"/>
                        <button name="action_unpublish" type="object" string="Unpublish" 
                                invisible="not is_published"/>
                        <field name="is_published" widget="statusbar" statusbar_visible="false,true"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_moderate" type="object" class="oe_stat_button" icon="fa-gavel">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Moderate</span>
                                </div>
                            </button>
                        </div>
                        
                        <group>
                            <group>
                                <field name="product_tmpl_id"/>
                                <field name="author_name"/>
                                <field name="author_email"/>
                                <field name="rating"/>
                                <field name="spam_score"/>
                            </group>
                            <group>
                                <field name="create_date"/>
                                <field name="is_moderated"/>
                                <field name="moderated_by" invisible="not is_moderated"/>
                                <field name="moderation_date" invisible="not is_moderated"/>
                                <field name="synced_to_core"/>
                                <field name="rating_hash"/>
                            </group>
                        </group>
                        
                        <group string="Content">
                            <field name="feedback" widget="text"/>
                        </group>
                        
                        <group string="Technical Information" groups="base.group_system">
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                            <field name="recaptcha_token"/>
                            <field name="moderation_reason" invisible="not moderation_reason"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu Items -->
        <record id="action_anonymous_rating_performance_monitor" model="ir.actions.act_window">
            <field name="name">Performance Monitor</field>
            <field name="res_model">anonymous.rating.performance.monitor</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_anonymous_rating_performance" 
                  name="Performance Monitor" 
                  parent="website.menu_website_configuration"
                  action="action_anonymous_rating_performance_monitor"
                  sequence="50"/>

    </data>
</odoo>