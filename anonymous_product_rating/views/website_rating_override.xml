<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Override the main product rating display in website_sale -->
        <template id="product_rating_override" inherit_id="website_sale.product" name="Product Rating Override" priority="99">
            <xpath expr="//t[@t-call='portal_rating.rating_widget_stars_static']" position="replace">
                <t t-call="portal_rating.rating_widget_stars_static">
                    <!-- Use total_rating_avg and total_rating_count for correct display -->
                    <t t-set="rating_avg" t-value="product.total_rating_avg"/>
                    <t t-set="trans_text_plural">%s reviews</t>
                    <t t-set="trans_text_singular">%s review</t>
                    <t t-set="rating_count" t-value="(trans_text_plural if product.total_rating_count > 1 else trans_text_singular) % product.total_rating_count"/>
                </t>
            </xpath>
        </template>

        <!-- Override ALL product snippet templates for shop page -->
        
        <!-- Template 1: Classic Card with Add to Cart -->
        <template id="shop_rating_override_1" inherit_id="website_sale.dynamic_filter_template_product_product_add_to_cart" name="Shop Rating Override 1" priority="99">
            <xpath expr="//t[@t-set='rating_avg'][@t-value='record.rating_avg']" position="attributes">
                <attribute name="t-value">record.total_rating_avg</attribute>
            </xpath>
            <xpath expr="//t[@t-set='rating_count'][@t-value='record.rating_count']" position="attributes">
                <attribute name="t-value">record.total_rating_count</attribute>
            </xpath>
        </template>

